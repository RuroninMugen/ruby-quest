<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { overflow: hidden; }
  .game-screen {
    width: 100vw; height: 100vh;
    position: relative; overflow: hidden;
  }
  .bg {
    width: 100%; height: 100%;
    background-image: url('<%= asset_path("rubyquest_bg.png") %>');
    background-size: cover;
    background-position: center;
  }
  .btn-overlay {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 280px;
    height: 52px;
    cursor: pointer;
    opacity: 0;
  }
  .btn-overlay:hover { opacity: 0.15; background: white; }
</style>

<div class="game-screen">
  <div class="bg"></div>
  <%= link_to "NOUVELLE PARTIE", new_user_registration_path, class: "btn-overlay", style: "top: 56%;" %>
  <%= link_to "CONTINUER", new_user_session_path, class: "btn-overlay", style: "top: 65%;" %>
</div>
